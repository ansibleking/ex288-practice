{
  "openapi": "3.0.1",
  "info": {
    "title": "TAMS Attendance API (example - replace with real swagger export)",
    "version": "v1"
  },
  "paths": {
    "/api/lgt/AttendanceReport": {
      "get": {
        "operationId": "AttendanceReport",
        "summary": "Attendance report for employee date range",
        "parameters": [
          {"name": "employeeid", "in": "query", "required": true, "schema": {"type": "string"}},
          {"name": "fromdate", "in": "query", "required": true, "schema": {"type": "string", "format": "date"}},
          {"name": "todate", "in": "query", "required": true, "schema": {"type": "string", "format": "date"}},
          {"name": "langcode", "in": "query", "schema": {"type": "string", "default": "en"}}
        ]
      }
    },
    "/api/lgt/GetEmployeeDetailsAD": {
      "get": {
        "operationId": "GetEmployeeDetailsAD",
        "summary": "Employee details from Active Directory mapping",
        "parameters": [
          {"name": "langcode", "in": "query", "schema": {"type": "string"}}
        ]
      }
    }
  }
}
