# Jira Data Center connection (service-account PAT, same account/instance
# pattern as the sibling network-access-review tool -- Bearer auth works
# fine here since this app only calls /rest/api/2/* endpoints, never
# attachment downloads).
JIRA_BASE_URL=https://jira.internal.example.com
JIRA_PAT=replace-with-service-account-personal-access-token

# Tickets this app creates are tagged with this label, and it's also used
# to scope the JQL search for "currently tracked" candidate tickets.
JIRA_MANAGED_LABEL=aiops-managed
JIRA_PROJECT_KEY=replace-with-project-key
JIRA_ISSUE_TYPE=Task

# Target status name for auto-resolve; the actual transition ID is resolved
# at runtime via GET /issue/{key}/transitions, so this just needs to match
# a real status name in your workflow.
JIRA_RESOLVED_TRANSITION_NAME=Resolved

# Set this if your Resolve transition's screen requires a text field (e.g.
# "Solution") -- Jira DC doesn't reliably list these as required ahead of
# time, so this usually gets discovered via a 400 like "X is required." on
# a real resolve attempt. Auto-resolve fills it with the resolution comment
# text. Leave empty if your workflow doesn't need this.
JIRA_RESOLUTION_FIELD_ID=

# Set false if your Jira permission scheme denies "Log Work" to the service
# account (check /rest/api/2/mypermissions?issueKey=X for WORK_ON_ISSUES on
# a real issue -- project-level checks can say true while issue-level says
# false). When false, log-work updates fall back to a comment instead.
JIRA_WORKLOG_ENABLED=true

# Extra fields merged into every issue-creation payload -- needed if your
# project requires custom fields beyond summary/description/labels (e.g. a
# Jira Service Management "Reporting Service" field). JSON object matching
# the Jira REST API field shape for each field. Leave as {} if not needed.
# Example: JIRA_EXTRA_CREATE_FIELDS={"customfield_14503": {"value": "IT Infrastructure"}}
JIRA_EXTRA_CREATE_FIELDS={}

# If a required field references an Insight/Assets catalog object (rather
# than a plain string) -- check via GET /rest/insight/1.0/objectschema/list
# and /rest/insight/1.0/objecttypes/flat on your instance, or the field's
# editmeta on an existing issue of that type. Leave JIRA_REPORTING_SERVICE_FIELD_ID
# empty to disable; when set, the app shows a searchable in-app picker fed
# from this catalog instead of requiring a fixed value here.
#
# IMPORTANT: the field's *filter scope* may restrict it to a specific object
# type that isn't the one its name suggests -- e.g. a field literally named
# "Reporting Service" was found (on this project) to require type "Affected
# Services", not the generic "Service" CMDB/CI type, even though both exist
# and both sound plausible. If ticket creation fails with "Provided Assets
# object/s does not match Filter Scopes", the object type below is wrong --
# find a real, already-successful issue with this field set, GET its value
# via /rest/api/2/issue/{key}?fields=<fieldId>, then look that object up via
# /rest/insight/1.0/iql/objects?iql=Key="<its-key>" to read its true
# objectType.name.
JIRA_REPORTING_SERVICE_FIELD_ID=
JIRA_REPORTING_SERVICE_OBJECT_TYPE=Service
JIRA_INSIGHT_OBJECT_SCHEMA_ID=1

# Other required plain Jira select fields (not Insight objects) beyond issue
# type and reporting service -- e.g. "Subsidiary" or "SR Type". Rather than
# hardcoding one fixed value via JIRA_EXTRA_CREATE_FIELDS above, the app
# discovers each field's real option list from a known-good existing issue's
# editmeta (createmeta returned 404 on this Jira DC instance, and there's no
# other generic "list options for field X" endpoint) and shows a picker for
# each one. JIRA_EXTRA_SELECT_FIELDS maps field id -> display label; set
# JIRA_FIELD_METADATA_REFERENCE_ISSUE to any real issue key that has all of
# those fields on its edit screen (a recently-created ticket in the same
# project/issue type works well). Leave JIRA_EXTRA_SELECT_FIELDS empty ({})
# if you don't need this.
JIRA_FIELD_METADATA_REFERENCE_ISSUE=
JIRA_EXTRA_SELECT_FIELDS={}

# Some workflows grant Approve/Reject to whoever is named in a user/group
# picker field (e.g. "IMD Domain Approvers") even when the ticket has no
# assignee -- the approvals list won't find those tickets from assignee
# alone. Add each such field id here (JSON array) as you discover them;
# leave empty ([]) if every approval on your instance goes through the
# assignee.
JIRA_APPROVER_FIELDS=[]

# LLM provider -- "anthropic" or "onprem". DEFAULT_LLM_MODEL is interpreted
# by whichever provider is active.
DEFAULT_LLM_PROVIDER=onprem
DEFAULT_LLM_MODEL=qwen/qwen3.5-122b-a10b

# Anthropic API. Gates two independent things: (1) classification, only when
# DEFAULT_LLM_PROVIDER=anthropic above; (2) the agentic resolve path
# (app/action_agent.py) -- Anthropic's Tool Runner has no equivalent for an
# on-prem endpoint, so with no key set here, resolve automatically falls
# back to the deterministic code path instead of erroring.
ANTHROPIC_API_KEY=replace-with-anthropic-api-key

# Model used for the agentic resolve path specifically -- independent of
# DEFAULT_LLM_MODEL, which is for classification. Only takes effect once
# ANTHROPIC_API_KEY above is a real key.
AGENT_MODEL=claude-opus-5

# On-prem, OpenAI-compatible endpoint (used when DEFAULT_LLM_PROVIDER=onprem)
# -- e.g. vLLM's OpenAI-compatible server, which must support
# response_format: {"type": "json_schema", ...} guided decoding for
# structured classification output to work.
ONPREM_LLM_BASE_URL=http://onprem-llm.internal:8000/v1
ONPREM_LLM_API_KEY=replace-with-onprem-api-key
# Set to false only if the endpoint uses a certificate your trust store
# doesn't recognize (e.g. an internal cluster CA). Prefer installing that
# CA into the container's trust store over disabling verification.
DEFAULT_LLM_VERIFY_SSL=true

# Autonomy thresholds -- starting guesses, tune after seeing real
# classifications. AUTONOMY_AUTO_SEVERITY_MAX is one of low/medium/high/critical;
# severity above this always requires human confirmation even at high confidence.
AUTONOMY_AUTO_CONFIDENCE_MIN=0.85
AUTONOMY_AUTO_SEVERITY_MAX=medium
AUTONOMY_UPDATE_CONFIDENCE_MIN=0.7

# SQLite audit trail location (inside the container; mounted to ./data via
# docker-compose.yml so it persists across restarts).
DATABASE_PATH=/data/audit.db
