# Copy to .env. This project is configured for a FLEET of Redfish servers by
# default — see endpoints.json (copy endpoints.example.json to get started).
# See server/README.md for the full option list.

# Path inside the container to the endpoints file (mounted by docker-compose.yml).
MIRASTACK_REDFISH_ENDPOINTS=/app/endpoints.json

# Which endpoint name (from endpoints.json) tools default to when a call
# omits "endpoint". Leave this line commented out (not set to an empty
# value — an empty string is rejected) to default to the first entry in the
# file. Uncomment and set only if you want a different default.
# MIRASTACK_REDFISH_DEFAULT_ENDPOINT=idrac-rack1-node1

# off | power | config | full — mutating tools aren't even registered below
# your chosen tier, and every mutation is dry-run-first regardless of tier.
# Start at "off" (read-only across the whole fleet) and raise it deliberately.
MIRASTACK_REDFISH_WRITE_MODE=off

# core | standard | full — which tool set the server registers.
MIRASTACK_REDFISH_TOOL_PROFILE=full

# --- Try it without real hardware (two fake BMCs) ---
# docker compose --profile mockup up -d --build
# (already wired to endpoints.mockup.json via docker-compose.yml)
