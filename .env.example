# TAMS Connect_API
TAMS_BASE_URL=https://tams.emaratech.ae
TAMS_AUTH_MODE=tams_login

# Connect_API credentials (same account used on attendance.emaratech.ae)
TAMS_USERNAME=t.mayilvahanan
TAMS_PASSWORD=DevarAnbu987!!!
TAMS_PAYCODE=
TAMS_COMPANY_CODE=EMCH
TAMS_AUTH_COMP=
TAMS_AUTH_DEPT=
TAMS_AUTH_LOC=
TAMS_AUTH_SITE=
TAMS_USER_TYPE=ESS


# Optional: bearer token copied from authenticated browser session
TAMS_ACCESS_TOKEN=

# Optional: Entra ID (only if API gateway requires Azure token in addition to TAMS login)
TAMS_API_SCOPE=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Swagger tool generation
SWAGGER_SPEC_PATH=swagger.json
SWAGGER_MAX_TOOLS=60
SWAGGER_INCLUDE_TAGS=login,DailyReports,MonthlyReports,LeaveReports,AttendanceCorrection,Employee,LeaveApplication

# Agent CLI — on-prem Qwen / OpenAI-compatible LLM
AGENT_LLM_PROVIDER=openai
ONPREM_LLM_BASE_URL=https://your-llm-host.example.com/v1
ONPREM_LLM_MODEL=qwen/qwen3.5-122b-a10b
OPENAI_API_KEY=your-jwt-or-api-key
LLM_TIMEOUT=120

# Internal CA / self-signed HTTPS (dnrd.gov.ae serving endpoints)
# Option A — disable verify (dev/internal only):
ONPREM_LLM_VERIFY_SSL=false
# Option B — mount corporate CA and point to it (preferred):
# LLM_CA_BUNDLE=/certs/dnrd-root-ca.pem

# Aliases also supported:
# OPENAI_BASE_URL=...
# AGENT_MODEL=...

# Switch LLM per run (recommended) — see docs/LLM_SWITCH.md
LLM_PROFILE=claude-sonnet
# Do NOT rely on ONPREM_LLM_* alone when using profiles; pick LLM_PROFILE or --llm

# Anthropic (use --llm claude-sonnet or AGENT_LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=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
